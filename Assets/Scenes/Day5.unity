  m_Name: 
  m_EditorClassIdentifier: 
  dialogue:
    sentences:
    - "\uC6D0\uC7A5\uC774 \uC785\uAD6C\uB97C \uB9C9\uACE0 \uC11C \uC788\uB2E4."
    - "..\uC5B4?.. \uC6D0\uC7A5\uB2D8..? \uC65C \uADF8\uB7EC\uC138\uC694?"
    - "\u2026"
    - "\u2026\u2026"
    - "\uC120\uC0DD\uB2D8, \uB180\uB790\uC5B4? \uC7A5\uB09C\uC774\uC57C \u314E\u314E
      \n\uD45C\uC815\uC774 \uC65C \uADF8\uB807\uAC8C \uAD73\uC5C8\uC5B4~"
    - "..\uD558\uD558.. \uB124.. \uAE5C\uC9DD \uB180\uB790\uB124\uC694..  \n\uC800
      \uD1F4\uADFC\uD574 \uBD10\uB3C4 \uB420\uAE4C\uC694?"
    - "\uC544, \uB0B4\uAC00 \uAE38\uC744 \uB9C9\uACE0 \uC788\uC5C8\uAD6C\uB098. \uBBF8\uC548\uD574\uC694!
      \n\uC5BC\uB978 \uB4E4\uC5B4\uAC00 \uBD10\uC694."
    - "\uB124, \uB0B4\uC77C \uBD59\uACA0\uC2B5\uB2C8\uB2E4!"
    sprites:
    - {fileID: 0}
    - {fileID: 1400631562976135681, guid: 02dfd94ab6669427396fd1ed99df1ee3, type: 3}
