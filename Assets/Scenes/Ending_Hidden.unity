--- !u!114 &1104828221
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1104828217}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 0a225450d2f794b6ca8d7a0dcd5abb9f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  Panel: {fileID: 1757514551}
  dialogue:
    sentences:
    - "\uADF8\uB9BC \uB4A4 \uB0A1\uC740 \uBB38\uC774 \uB9CC\uC838\uC9C4\uB2E4."
    - "\uB07C\uC774\uC775.."
    - "'\uBE68\uB9AC \uBC16\uC73C\uB85C \uB098\uAC00\uC57C \uD574\u2026!'"
    - "'\uB4DC\uB514\uC5B4\u2026 \uB098\uC654\uC5B4. \uC0B4\uC544\uC11C \uB098\uC654\uC5B4\u2026'"
    - "'\uADF8 \uC9D1\uC5D0\uC11C, \uADF8 \uC544\uC774\uD55C\uD14C\uC11C\u2026'"
    - "\uC9C0\uB098\uAC00\uB294 \uC0AC\uB78C\uC5D0\uAC8C \uB2E4\uAE09\uD558\uAC8C
      \uB2E4\uAC00\uAC04\uB2E4."
    - "\uC800\uAE30\uC694! \uC800 \uC5B4\uB9B0\uC774\uC9D1 \uC548\uC5D0\u2026 \uAD34\uBB3C\uC774
      \uC788\uC5B4\uC694!"
    - "\uC544\uC774\uB4E4\uC774 \uC704\uD5D8\uD574\uC694! \uBE68\uB9AC\u2014"
    - "\uC544\uAC00\uC528, \uAD1C\uCC2E\uC544\uC694\u2026? \uBB34\uC2A8 \uC18C\uB9AC\uC608\uC694?"
    - "\uC800 \uC5B4\uB9B0\uC774\uC9D1\uC740 \uC778\uC801 \uB04A\uAE34 \uC9C0 \uC624\uB798\uB410\uB294\uB370?"
    - "\uBCD1\uC6D0 \uAC00 \uBD10\uC57C \uD558\uB294 \uAC70 \uC544\uB2C8\uC57C\u2026?"
    - "\u2026\uC544\uC9C1\uB3C4\u2026 \uADF8 \uC544\uC774 \uBAA9\uC18C\uB9AC\uAC00
      \uB4E4\uB824."
    - "\uC548\uC5D0\u2026 \uC544\uC9C1, \uC788\uC5B4."
    - "\uC9C0\uAE08\uB3C4 \uB204\uAD70\uAC00 \uB4E4\uC5B4\uAC00\uBA74..."
    - "\uBE68\uB9AC \uAC00\uC57C \uD558\uB294\uB370\u2026!"
